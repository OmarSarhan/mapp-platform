{
  "name": "MAPP Platform",
  // A base environment to run the platform FROM, not one that contains it.
  // Everything MAPP runs -- PostgreSQL, XYZ, the dashboard, the semantic
  // service, the demo's source databases -- runs in containers started by
  // ./bin/mapp. This container only needs the handful of tools that wrapper
  // uses on the host: docker, python3, openssl and curl. The stock image
  // provides the last three; the Dockerfile exists solely to remove a broken
  // apt source that would otherwise stop the docker-in-docker feature
  // installing. See the comment in it before changing this.
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    // Docker-in-docker, deliberately, not docker-outside-of-docker. The
    // Compose model bind-mounts ./var, ./instance and ./docker, and those
    // paths only resolve correctly if the daemon shares this container's
    // filesystem. The trade is that MAPP's volumes live inside this
    // container: rebuilding it discards the database and you start again
    // with ./bin/mapp init --demo.
    "ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {}
  },
  // HTTP_PORT from .env.example. The map is served here, and the dashboard
  // on the same port under the config.localhost host name -- most browsers
  // resolve any *.localhost name to the loopback address, so both work once
  // this port is forwarded.
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "MAPP (map, and dashboard at config.localhost:3000)",
      "onAutoForward": "notify"
    }
  },
  // uid 1000, matching CONFIG_UID/CONFIG_GID in the Compose model. The
  // services run as that uid and write to ./var, so a mismatch here leaves
  // the wrapper unable to read the state it just created.
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "terminal.integrated.cwd": "${workspaceFolder}",
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "postAttachCommand": {
    "next-steps": "printf '\\nMAPP Platform. To stand up the demo:\\n  ./bin/mapp init --demo\\n  ./bin/mapp all\\n  ./bin/mapp demo\\nThen open http://localhost:3000 and http://config.localhost:3000\\nGuide: docs/guide.md\\n\\n'"
  }
}