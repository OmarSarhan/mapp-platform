#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Build single-manifest images, not manifest lists.
#
# buildx attaches provenance attestations by default, which turns even a
# single-platform local build into an attestation manifest plus a manifest
# list. Exporting that into the containerd image store fails inside
# docker-in-docker:
#
#   exporting attestation manifest sha256:...
#   exporting manifest list sha256:...
#   unpacking to docker.io/library/mapp-postgis-h3:...
#   failed to extract layer sha256:...: content digest sha256:... not found
#
# It looks like a corrupted cache and survives clearing one, because the
# corruption is being created by the export. MAPP builds local images for one
# platform and consumes them on the same daemon, so the attestations buy
# nothing here. Overridable, for anyone who does want them.
export BUILDX_NO_DEFAULT_ATTESTATIONS="${BUILDX_NO_DEFAULT_ATTESTATIONS:-1}"
ENV_FILE="${MAPP_ENV_FILE:-${ROOT_DIR}/.env}"
STATE_DIR="${ROOT_DIR}/var"
WORKSPACE_DIR="${STATE_DIR}/workspace"
CONTROL_DIR="${STATE_DIR}/control"
RELOAD_DIR="${STATE_DIR}/reload"
PREVIEW_DIR="${STATE_DIR}/preview"
PREVIEW_RELOAD_DIR="${STATE_DIR}/preview-reload"
# Holds only the authorization component's edge socket. Caddy mounts it to
# connect; nothing else is shared between the two containers.
MCP_SOCKET_DIR="${STATE_DIR}/mcp-auth"
# The runtime's own socket, and a separate directory because the two processes
# are separate: caddy mounts this one too. It has to be created here even when
# MAPP_MCP is unset, because caddy mounts it unconditionally -- and a bind
# mount whose source does not exist is created by Docker, as root. The next
# command then refuses to run against state it cannot write.
MCP_RUNTIME_SOCKET_DIR="${STATE_DIR}/mapp-mcp"

usage() {
  printf '%s\n' \
    "Usage: ./bin/mapp <command>" \
    "" \
    "  init [--demo] create a private .env from .env.example" \
    "  up [--force-recreate] build/start the database and platform services" \
    "  serve [--force-recreate] start platform services without running bundled ETL" \
    "  reload-xyz   reload XYZ and wait for the current workspace fingerprint" \
    "  config-ui    build/start the workspace configuration dashboard" \
    "  config-ui-down stop and remove only the configuration dashboard" \
    "  recover-reset-system --confirm recover a retained database after an interrupted reset" \
    "  reset-config-password generate a new config UI administrator password" \
    "  revoke-config-tokens revoke every remote CLI token" \
    "  mcp-client-register --name N --redirect-uri U --scope S  register an MCP agent client" \
    "  mcp-client-list list registered MCP clients" \
    "  mcp-client-disable --client-id ID  disable an MCP client" \
    "  mcp-runtime-register register or rotate the MCP runtime's own credential" \
    "  migrate-rollback --to N [--confirm]  step the control schema ladder down; destructive, prints the plan first" \
    "  advance-recovery-epoch [--confirm]  invalidate every credential a restored database brought back; destructive, prints the plan first" \
    "  census-check [topic] validate all or one reviewed census source without loading" \
    "  reset-system --confirm return the platform to its initial state: new database, seed workspace, new administrator password" \
    "  upgrade-derived repair H3, derived roles, and spatial indexes in an existing bundled database" \
    "  all          start the platform, then verify it" \
    "  test         run local unit and configuration tests" \
    "  doctor [--add-missing] report .env key drift; optionally add safe defaults" \
    "  production-acceptance [options] collect redacted production readiness evidence" \
    "  cleanup-temp [--confirm] list or remove disposable state older than seven days" \
    "  verify       run end-to-end acceptance checks" \
    "  demo [--no-semantics] seed the demo sources and publish their map layers" \
    "  federation-test run the federation lifecycle against the test source" \
    "  config       validate the Compose configuration" \
    "  build-xyz    rebuild the pinned XYZ image" \
    "  ps           show service state" \
    "  logs         follow service logs" \
    "  db           open psql inside the bundled sample database" \
    "  stop         stop services without deleting data" \
    "  down         remove containers/networks, preserving data"
  printf '%s\n' \
    "" \
    "Set MAPP_ENVIRONMENT=production in .env to include compose.production.yaml and" \
    "enforce production-only HTTPS host settings for every wrapper command." \
    "" \
    "Set MAPP_DEMO_SOURCES in .env, or run init --demo, to include" \
    "compose.federated-demo.yaml and start the two Leeds source databases." \
    "Load them with ./bin/mapp demo, once the platform is running."
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    printf 'Docker is not installed in this shell. Rebuild the devcontainer or run from a Docker-enabled host.\n' >&2
    exit 127
  fi
  if ! docker compose version >/dev/null 2>&1; then
    printf 'Docker Compose v2 is required.\n' >&2
    exit 127
  fi
}

is_buildkit_lease_failure() {
  local log_file="$1"
  grep -Eq 'lease "[^"]+": not found|lease [^ ]+ not found' "${log_file}"
}

run_with_buildkit_lease_retry() {
  local log_file status retry_status
  log_file="$(mktemp "${TMPDIR:-/tmp}/mapp-buildkit.XXXXXX")"
  set +e
  "$@" 2> >(tee "${log_file}" >&2)
  status=$?
  set -e
  if [[ "${status}" == "0" ]]; then
    rm -f "${log_file}"
    return 0
  fi
  if ! is_buildkit_lease_failure "${log_file}"; then
    rm -f "${log_file}"
    return "${status}"
  fi

  printf '%s\n' \
    'Docker BuildKit reported a missing cache lease; pruning BuildKit cache and retrying once.' \
    'If the retry also fails, inspect Docker daemon health and available disk space.' >&2
  docker buildx prune --all --force

  set +e
  "$@"
  retry_status=$?
  set -e
  rm -f "${log_file}"
  return "${retry_status}"
}

dotenv_value() {
  local key="$1"
  local source_file="${2:-${ENV_FILE}}"
  local value
  value="$(
    sed -n "s/^${key}=//p" "${source_file}" \
      | tail -n 1
  )"
  value="${value%$'\r'}"
  if [[ "${value}" == \"*\" && "${value}" == *\" ]]; then
    value="${value:1:${#value}-2}"
  elif [[ "${value}" == \'*\' && "${value}" == *\' ]]; then
    value="${value:1:${#value}-2}"
  fi
  printf '%s' "${value}"
}

environment_value() {
  local key="$1"
  if [[ -v "${key}" ]]; then
    printf '%s' "${!key}"
  else
    dotenv_value "${key}"
  fi
}

require_federation_settings() {
  local key
  local -a missing=()
  for key in \
    FEDERATION_DB_USER FEDERATION_DB_PASSWORD FEDERATION_DATABASE_URL
  do
    if [[ -z "$(dotenv_value "${key}")" ]]; then
      missing+=("${key}")
    fi
  done
  if (( ${#missing[@]} > 0 )); then
    printf 'The MAPP database requires federation settings missing from %s: %s\n' \
      "${ENV_FILE}" "${missing[*]}" >&2
    printf 'Run ./bin/mapp doctor --add-missing, then retry.\n' >&2
    exit 2
  fi
}

reject_database_environment_overrides() {
  local key configured
  for key in \
    "${!DBS_@}" "${!FEDERATION_DBS_@}" \
    ETL_DATABASE_URL POSTGRES_DB POSTGRES_USER POSTGRES_PASSWORD \
    ETL_DB_USER ETL_DB_PASSWORD XYZ_DB_USER XYZ_DB_PASSWORD \
    DERIVED_DB_USER DERIVED_DB_PASSWORD DERIVED_DATABASE_URL \
    DERIVED_OWNER_ROLE DERIVED_READER_ROLE \
    FEDERATION_DB_USER FEDERATION_DB_PASSWORD FEDERATION_DATABASE_URL \
    SEMANTIC_DB_USER SEMANTIC_DB_PASSWORD SEMANTIC_DATABASE_URL \
    SEMANTIC_READER_DB_USER SEMANTIC_READER_DB_PASSWORD SEMANTIC_READER_DATABASE_URL \
    CONTROL_DB_USER CONTROL_DB_PASSWORD CONTROL_DATABASE_URL \
    SOURCE_POSTGRES_DB SOURCE_POSTGRES_USER SOURCE_POSTGRES_PASSWORD \
    SOURCE_READER_USER SOURCE_READER_PASSWORD
  do
    if [[ -v "${key}" ]]; then
      configured="$(dotenv_value "${key}")"
      if [[ "${!key}" != "${configured}" ]]; then
        printf 'Exported %s conflicts with the authoritative value in %s; unset it or update the env file deliberately.\n' \
          "${key}" "${ENV_FILE}" >&2
        exit 2
      fi
      # Shell values outrank --env-file interpolation in Compose. Remove an
      # exact duplicate so nested values such as DBS_MAPP resolve from .env.
      unset "${key}"
    fi
  done
}

clear_edge_environment_overrides() {
  local key
  for key in \
    EDGE_BIND_ADDRESS HTTP_PORT HTTPS_PORT MAP_SITE CONFIG_SITE MCP_SITE CADDY_EMAIL
  do
    if [[ -v "${key}" ]]; then
      # Shell values outrank --env-file interpolation in Compose. Edge
      # settings are always sourced from the reviewed env file.
      unset "${key}"
    fi
  done
}

state_owner_error() {
  local expected_uid="$1"
  local expected_gid="$2"
  local path="${3:-${STATE_DIR}}"
  printf 'Writable state ownership does not match CONFIG_UID=%s and CONFIG_GID=%s: %s\n' \
    "${expected_uid}" "${expected_gid}" "${path}" >&2
  printf 'Repair it deliberately, for example: sudo chown -R %s:%s %q\n' \
    "${expected_uid}" "${expected_gid}" "${STATE_DIR}" >&2
  exit 2
}

check_state_owner() {
  local expected_uid expected_gid mismatch path
  expected_uid="$(environment_value CONFIG_UID)"
  expected_gid="$(environment_value CONFIG_GID)"
  if [[ ! "${expected_uid}" =~ ^[0-9]+$ || ! "${expected_gid}" =~ ^[0-9]+$ ]]; then
    printf 'CONFIG_UID and CONFIG_GID must be numeric.\n' >&2
    exit 2
  fi
  if [[ -e "${STATE_DIR}" ]]; then
    if [[ "$(stat -c %u "${STATE_DIR}")" != "${expected_uid}" \
      || "$(stat -c %g "${STATE_DIR}")" != "${expected_gid}" ]]; then
      state_owner_error "${expected_uid}" "${expected_gid}"
    fi
    mismatch="$(
      find "${STATE_DIR}" -xdev \
        \( ! -uid "${expected_uid}" -o ! -gid "${expected_gid}" \) \
        -print -quit 2>/dev/null || true
    )"
    if [[ -n "${mismatch}" ]]; then
      state_owner_error "${expected_uid}" "${expected_gid}" "${mismatch}"
    fi
  fi
  if [[ "$(id -u)" != "${expected_uid}" || "$(id -g)" != "${expected_gid}" ]]; then
    for path in \
      "${STATE_DIR}" \
      "${WORKSPACE_DIR}" \
      "${CONTROL_DIR}" \
      "${CONTROL_DIR}/artifacts" \
      "${CONTROL_DIR}/proposals" \
      "${RELOAD_DIR}" \
      "${PREVIEW_DIR}" \
      "${PREVIEW_RELOAD_DIR}"
    do
      if [[ ! -e "${path}" ]]; then
        state_owner_error "${expected_uid}" "${expected_gid}" "${path}"
      fi
    done
  fi
}

init_state() {
  umask 077
  mkdir -p \
    "${WORKSPACE_DIR}" \
    "${CONTROL_DIR}/artifacts" \
    "${CONTROL_DIR}/proposals" \
    "${RELOAD_DIR}" \
    "${PREVIEW_DIR}" \
    "${PREVIEW_RELOAD_DIR}" \
    "${MCP_SOCKET_DIR}" \
    "${MCP_RUNTIME_SOCKET_DIR}"
  chmod 700 \
    "${STATE_DIR}" \
    "${WORKSPACE_DIR}" \
    "${CONTROL_DIR}" \
    "${CONTROL_DIR}/artifacts" \
    "${CONTROL_DIR}/proposals" \
    "${RELOAD_DIR}" \
    "${PREVIEW_DIR}" \
    "${PREVIEW_RELOAD_DIR}" \
    "${MCP_SOCKET_DIR}" \
    "${MCP_RUNTIME_SOCKET_DIR}"

  if [[ ! -f "${WORKSPACE_DIR}/workspace.json" ]]; then
    if [[ ! -f "${ROOT_DIR}/instance/workspace.seed.json" ]]; then
      printf 'Missing workspace seed: %s/instance/workspace.seed.json\n' "${ROOT_DIR}" >&2
      exit 2
    fi
    cp "${ROOT_DIR}/instance/workspace.seed.json" "${WORKSPACE_DIR}/workspace.json"
    chmod 644 "${WORKSPACE_DIR}/workspace.json"
    printf 'Created live workspace from instance/workspace.seed.json.\n'
  fi
  if [[ ! -f "${PREVIEW_DIR}/workspace.json" ]]; then
    cp "${WORKSPACE_DIR}/workspace.json" "${PREVIEW_DIR}/workspace.json"
    chmod 600 "${PREVIEW_DIR}/workspace.json"
  fi
}

# Every one of these is required-variable syntax in compose.federated-demo.yaml,
# so turning the demo on without them breaks every later subcommand -- including
# down, ps and logs. Refuse rather than let an operator brick their teardown by
# switching a demo on.
validate_demo_sources() {
  local demo_environment key
  local source_file="${1:-${ENV_FILE}}"
  local -a missing=()
  # Refused before anything is written. init runs ahead of the production
  # environment gate below, and validate_production_env refuses a non-empty
  # MAPP_DEMO_SOURCES -- so writing one here would leave a production
  # deployment where every wrapper command, teardown and log reading
  # included, fails until somebody hand-edits the file back.
  demo_environment="$(dotenv_value MAPP_ENVIRONMENT "${source_file}")"
  if [[ "${demo_environment}" == "production" ]]; then
    printf 'Refusing to enable demo sources: %s is a production environment.\n' \
      "${source_file}" >&2
    printf 'The demo stands up throwaway self-signed source databases; production refuses them.\n' >&2
    exit 2
  fi
  if [[ "${demo_environment}" != "development" ]]; then
    printf 'Refusing to enable demo sources: MAPP_ENVIRONMENT in %s must be development.\n' \
      "${source_file}" >&2
    exit 2
  fi
  for key in \
    CENSUS_POSTGRES_DB CENSUS_POSTGRES_PASSWORD \
    OPS_POSTGRES_DB OPS_POSTGRES_PASSWORD \
    SOURCE_POSTGRES_USER SOURCE_READER_USER SOURCE_READER_PASSWORD \
    FEDERATION_DBS_CENSUS FEDERATION_DBS_OPS
  do
    if [[ -z "$(dotenv_value "${key}" "${source_file}")" ]]; then
      missing+=("${key}")
    fi
  done
  # Empty deliberately means "describe every field", but the key itself must
  # exist: .env is the source of truth for the demo field limit.
  if ! grep -q '^MAPP_DEMO_FIELD_LIMIT=' "${source_file}"; then
    missing+=("MAPP_DEMO_FIELD_LIMIT")
  fi
  if (( ${#missing[@]} > 0 )); then
    printf 'The demo sources need settings missing from %s: %s\n' \
      "${source_file}" "${missing[*]}" >&2
    printf 'Run ./bin/mapp doctor --add-missing, then retry.\n' >&2
    exit 2
  fi
}

enable_demo_sources() {
  if grep -q '^MAPP_DEMO_SOURCES=' "${ENV_FILE}"; then
    sed -i 's/^MAPP_DEMO_SOURCES=.*/MAPP_DEMO_SOURCES=leeds/' "${ENV_FILE}"
  else
    printf 'MAPP_DEMO_SOURCES=leeds\n' >>"${ENV_FILE}"
  fi
  printf 'Enabled the demo sources in %s.\n' "${ENV_FILE}"
  printf 'Next: ./bin/mapp all to start the platform, then ./bin/mapp demo to load demo data.\n'
}

report_admin_bootstrap() {
  # config_admin prints either the new password or a line saying credentials
  # already existed. Deciding which by *containment* rather than an exact
  # string compare: the previous version compared the whole line, so a single
  # stray byte on stdout silently turned a real new password into "left
  # alone", and the operator was locked out of a system they had just created.
  local output="$1" password="$2"
  if [[ "${output}" == *"${password}"* ]]; then
    printf 'Configuration administrator password (shown once): %s\n' "${password}"
  else
    printf '%s\n' "${output}"
    printf 'Run ./bin/mapp reset-config-password if you no longer have the password.\n'
  fi
}

ensure_runtime_client_registered() {
  # The MCP runtime presents a confidential client secret to the authorization
  # component's control listener, and that client has to exist in the control
  # schema before any call it makes can succeed. Registering it here is what
  # makes the demo work from a fresh clone: the alternative is a platform that
  # starts, looks healthy, and refuses every MCP call until somebody finds the
  # command.
  #
  # Still a registration rather than an environment variable on the component:
  # only the digest is stored, so the component that verifies the secret never
  # holds it, and rotating it is this call rather than a restart of the
  # authorization server.
  local secret
  secret="$(dotenv_value MAPP_MCP_CLIENT_SECRET)"
  if [[ -z "${secret}" || "${secret}" == CHANGEME_* ]]; then
    # Blank is a deliberate configuration: run without the MCP runtime.
    return 0
  fi
  # `exec`, not `run`: this is called immediately after `up --build` has
  # brought config-ui up, so there is a running container to use and no
  # reason to resolve an image at all. It also sidesteps the two ways a
  # `run` goes wrong here -- pulling an image this repository builds, and
  # rendering build progress into a capture, which fails on an interactive
  # terminal.
  #
  # The output is kept rather than discarded. The reason this failed is the
  # one thing worth having, because the symptom it produces names something
  # else entirely: an unregistered runtime makes every MCP call answer 503
  # "The authorization component is unavailable", which is false -- the
  # component is up, and the runtime's own credential is what is missing.
  local registration
  if ! registration="$(printf '%s\n' "${secret}" \
    | "${compose[@]}" exec -T config-ui \
        python config_admin.py mcp-runtime-register \
          --root /control --secret-stdin 2>&1)"; then
    printf 'Could not register the MCP runtime client; MCP calls will be refused with 503 "authorization_unavailable".\n' >&2
    printf '%s\n' "${registration}" >&2
    printf '  Retry with ./bin/mapp mcp-runtime-register once the platform is up.\n' >&2
    return 0
  fi
}

bootstrap_admin_credential() {
  # The administrator credential lives in the control schema, so it cannot be
  # created on the host: the packaged database publishes no port, and its DSN
  # names `db`, which resolves only inside the compose network. init therefore
  # starts the database and mints the credential in a container. .env must
  # already exist, because compose needs it to resolve the database at all --
  # which is why this runs after the template is written, not before.
  local demo_flag="${1:-}"
  local admin_password admin_output admin_command="init"
  command -v openssl >/dev/null 2>&1 || {
    printf 'openssl is required to generate the configuration administrator password.\n' >&2
    exit 127
  }
  if [[ -n "${MAPP_BOOTSTRAP_DATABASE_URL:-}" ]]; then
    # An explicit control database was supplied, so there is nothing to start
    # and no container to reach it through. This is the path an
    # external-PostgreSQL deployment takes -- it has no packaged database to
    # bring up -- and it is also what lets the wrapper's own tests exercise
    # init without a compose model.
    admin_password="$(openssl rand -base64 24 | tr -d '\n' | tr '/+' '_-')"
    if [[ "${demo_flag}" == "--demo" ]]; then
      admin_command="reset-demo"
    fi
    if ! admin_output="$(printf '%s\n' "${admin_password}" \
      | CONTROL_DATABASE_URL="${MAPP_BOOTSTRAP_DATABASE_URL}" \
        python3 "${ROOT_DIR}/config-ui/config_admin.py" "${admin_command}" \
          --root "${CONTROL_DIR}" \
          --password-stdin)"; then
      printf '%s\n' "${admin_output}" >&2
      exit 1
    fi
    report_admin_bootstrap "${admin_output}" "${admin_password}"
    if [[ "${admin_command}" == "reset-demo" ]]; then
      printf 'Revoked all existing CLI API tokens and outstanding device authorizations for demo mode.\n'
    fi
    return
  fi
  require_docker
  local -a init_compose=(
    docker compose
    --project-directory "${ROOT_DIR}"
    --env-file "${ENV_FILE}"
    --file "${ROOT_DIR}/compose.yaml"
    --file "${ROOT_DIR}/compose.bundled-db.yaml"
  )
  # Built as its own visible step, for the same reason the configuration
  # image below is, plus one more: on a fresh machine this compiles PostGIS
  # and H3 from source. Folded into the `up` and silenced, it was ten minutes
  # in which init printed nothing at all and gave an operator no way to tell a
  # long build from a hang.
  printf 'Building the packaged database image. The first run compiles PostGIS and H3 from source and usually takes several minutes.\n'
  if ! "${init_compose[@]}" build db; then
    printf 'Could not build the packaged database image.\n' >&2
    exit 1
  fi
  printf 'Starting the database and waiting for it to accept connections.\n'
  # --no-build: the image was just built as a visible step, so this waits and
  # nothing more. That is what makes discarding its output safe.
  if ! "${init_compose[@]}" up --detach --no-build --wait db >/dev/null 2>&1; then
    printf 'Could not start the packaged database to initialize authentication.\n' >&2
    exit 1
  fi
  if [[ "${demo_flag}" == "--demo" ]]; then
    # Demo credentials are disposable: reset clears sessions, revokes API
    # tokens and leaves the newly printed password as the only credential.
    # config_admin init refuses to overwrite an existing one.
    admin_command="reset-demo"
  fi
  admin_password="$(openssl rand -base64 24 | tr -d '\n' | tr '/+' '_-')"
  # --no-deps because the database is already up and nothing else is needed;
  # without the explicit `up` above this would run with no database at all.
  #
  # Built as its own step, not with `run --build`, and the difference is the
  # whole point. `run` does not build while `up` does, so a fresh clone used to
  # fail with "pull access denied for mapp-config-ui" -- compose reading an
  # image this repository builds as a registry reference. Passing --build fixed
  # that and broke something else: this run's stdout is captured to read the
  # password out of it, and BuildKit rendering progress into a captured pipe
  # from an interactive terminal dies with "failed to get console: provided
  # file is not a console".
  #
  # Building first puts the progress on the operator's terminal where it
  # belongs and leaves the capture wrapping nothing but the password. It also
  # means a build failure is reported as a build failure rather than as an
  # unreadable password.
  printf 'Building the configuration service image.\n'
  if ! "${init_compose[@]}" build config-ui; then
    printf 'Could not build the configuration service image.\n' >&2
    exit 1
  fi
  printf 'Creating the configuration administrator credential.\n'
  if ! admin_output="$(printf '%s\n' "${admin_password}" \
    | "${init_compose[@]}" run --rm --no-deps -T config-ui \
        python config_admin.py "${admin_command}" \
          --root /control \
          --password-stdin)"; then
    printf '%s\n' "${admin_output}" >&2
    exit 1
  fi
  report_admin_bootstrap "${admin_output}" "${admin_password}"
  if [[ "${admin_command}" == "reset-demo" ]]; then
    printf 'Revoked all existing CLI API tokens and outstanding device authorizations for demo mode.\n'
  fi
}

init_env() {
  local demo_flag="${1:-}"
  local admin_password=""
  local admin_output=""
  local admin_command="init"
  local demo_source_file="${ENV_FILE}"
  if [[ ! -e "${ENV_FILE}" && ! -f "${ROOT_DIR}/.env.example" ]]; then
    # A failed init must not rotate credentials or revoke tokens retained in
    # var/control from an earlier installation.
    printf 'Missing initialization template: %s/.env.example\n' "${ROOT_DIR}" >&2
    exit 2
  fi
  if [[ "${demo_flag}" == "--demo" ]]; then
    # Refuse invalid demo opt-ins before rotating any existing credentials.
    if [[ ! -e "${ENV_FILE}" ]]; then
      demo_source_file="${ROOT_DIR}/.env.example"
    fi
    validate_demo_sources "${demo_source_file}"
  fi
  init_state
  if [[ -e "${ENV_FILE}" ]]; then
    # The environment is already written, so the database can be started from
    # it directly. The credential still has to be checked: it lives in the
    # database now, not in var/, so an existing .env says nothing about
    # whether authentication was ever initialized.
    bootstrap_admin_credential "${demo_flag}"
    if [[ "${demo_flag}" == "--demo" ]]; then
      enable_demo_sources
      return
    fi
    printf 'Initialization skipped: %s already exists and was left unchanged.\n' "${ENV_FILE}"
    return
  fi

  command -v openssl >/dev/null 2>&1 || {
    printf 'openssl is required to generate local passwords.\n' >&2
    exit 127
  }

  umask 077
  local -a template_edits=(
    -e "s/CHANGEME_POSTGRES$/$(openssl rand -hex 24)/"
    -e "s/CHANGEME_ETL$/$(openssl rand -hex 24)/"
    -e "s/CHANGEME_XYZ$/$(openssl rand -hex 24)/"
    -e "s/CHANGEME_DERIVED$/$(openssl rand -hex 24)/"
    -e "s/CHANGEME_FEDERATION$/$(openssl rand -hex 24)/"
    -e "s/CHANGEME_SOURCE_POSTGRES$/$(openssl rand -hex 24)/"
    -e "s/CHANGEME_SOURCE_READER$/$(openssl rand -hex 24)/"
    -e "s/CHANGEME_CENSUS_POSTGRES$/$(openssl rand -hex 24)/"
    -e "s/CHANGEME_OPS_POSTGRES$/$(openssl rand -hex 24)/"
    # The three semantic placeholders share a prefix, so each is anchored to
    # the end of its line and cannot rewrite the head of a longer one.
    -e "s/CHANGEME_SEMANTIC$/$(openssl rand -hex 32)/"
    -e "s/CHANGEME_SEMANTIC_CRUD$/$(openssl rand -hex 24)/"
    -e "s/CHANGEME_SEMANTIC_READER$/$(openssl rand -hex 24)/"
    -e "s/CHANGEME_CONTROL$/$(openssl rand -hex 24)/"
    -e "s/CHANGEME_MCP_AUTH$/$(openssl rand -hex 32)/"
    -e "s/CHANGEME_MAPP_MCP$/$(openssl rand -hex 32)/"
    -e "s/^CONFIG_UID=.*/CONFIG_UID=$(id -u)/"
    -e "s/^CONFIG_GID=.*/CONFIG_GID=$(id -g)/"
  )
  if [[ "${demo_flag}" == "--demo" ]]; then
    template_edits+=(-e "s/^MAPP_DEMO_SOURCES=.*/MAPP_DEMO_SOURCES=leeds/")
  fi
  sed "${template_edits[@]}" "${ROOT_DIR}/.env.example" >"${ENV_FILE}"
  chmod 600 "${ENV_FILE}"
  printf 'Created %s with URL-safe local passwords.\n' "${ENV_FILE}"
  bootstrap_admin_credential "${demo_flag}"
  # Both paths end by naming the next command. demo needs the platform up --
  # it mints a token inside config-ui and drives registration over HTTP -- so
  # all comes first either way.
  if [[ "${demo_flag}" == "--demo" ]]; then
    printf 'Set GEMINI_APIKEY in %s if you want the relations described.\n' \
      "${ENV_FILE}"
    printf 'Next: ./bin/mapp all to start the platform, then ./bin/mapp demo to load the sources.\n'
  else
    printf 'Next: ./bin/mapp all to start the platform and verify it.\n'
  fi
}

if [[ "${1:-}" == "init" ]]; then
  if [[ -n "${3:-}" ]] || [[ -n "${2:-}" && "${2}" != "--demo" ]]; then
    printf 'Usage: ./bin/mapp init [--demo]\n' >&2
    exit 2
  fi
  init_env "${2:-}"
  exit 0
fi

