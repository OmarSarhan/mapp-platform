#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${MAPP_ENV_FILE:-${ROOT_DIR}/.env}"
STATE_DIR="${ROOT_DIR}/var"
WORKSPACE_DIR="${STATE_DIR}/workspace"
CONTROL_DIR="${STATE_DIR}/control"
SEMANTIC_DIR="${STATE_DIR}/semantic"
RELOAD_DIR="${STATE_DIR}/reload"
PREVIEW_DIR="${STATE_DIR}/preview"
PREVIEW_RELOAD_DIR="${STATE_DIR}/preview-reload"

usage() {
  printf '%s\n' \
    "Usage: ./bin/mapp <command>" \
    "" \
    "  init         create a private .env from .env.example" \
    "  up           build/start the configured database mode and platform services" \
    "  serve        start platform services without running bundled ETL" \
    "  reload-xyz   reload XYZ and wait for the current workspace fingerprint" \
    "  config-ui    build/start the workspace configuration dashboard" \
    "  config-ui-down stop and remove only the configuration dashboard" \
    "  recover-reset-data --confirm recover a retained database after an interrupted reset" \
    "  reset-config-password generate a new config UI administrator password" \
    "  revoke-config-tokens revoke every remote CLI token" \
    "  etl [layer]  load sample and Census data in bundled-database mode" \
    "  census-etl   load the reviewed England Census 2021 OA dataset" \
    "  census-check [topic] validate all or one reviewed census source without loading" \
    "  reset-data --confirm remove the bundled database and reload configured ETL data" \
    "  upgrade-derived install H3 and derived-layer roles into an existing bundled database" \
    "  all          start bundled mode, load bundled ETL data, then verify it" \
    "  test         run local unit and configuration tests" \
    "  doctor [--add-missing] report .env key drift; optionally add safe defaults" \
    "  production-acceptance [options] collect redacted production readiness evidence" \
    "  cleanup-temp [--confirm] list or remove disposable state older than seven days" \
    "  verify       run end-to-end acceptance checks" \
    "  config       validate the Compose configuration" \
    "  build-xyz    rebuild the pinned XYZ image" \
    "  ps           show service state" \
    "  logs         follow service logs" \
    "  db           open psql inside the bundled sample database" \
    "  stop         stop services without deleting data" \
    "  down         remove containers/networks, preserving data"
  printf '%s\n' \
    "" \
    "Set MAPP_ENVIRONMENT=production in .env to include compose.production.yaml and" \
    "enforce production-only HTTPS host settings for every wrapper command."
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    printf 'Docker is not installed in this shell. Rebuild the devcontainer or run from a Docker-enabled host.\n' >&2
    exit 127
  fi
  if ! docker compose version >/dev/null 2>&1; then
    printf 'Docker Compose v2 is required.\n' >&2
    exit 127
  fi
}

is_buildkit_lease_failure() {
  local log_file="$1"
  grep -Eq 'lease "[^"]+": not found|lease [^ ]+ not found' "${log_file}"
}

run_with_buildkit_lease_retry() {
  local log_file status retry_status
  log_file="$(mktemp "${TMPDIR:-/tmp}/mapp-buildkit.XXXXXX")"
  set +e
  "$@" 2> >(tee "${log_file}" >&2)
  status=$?
  set -e
  if [[ "${status}" == "0" ]]; then
    rm -f "${log_file}"
    return 0
  fi
  if ! is_buildkit_lease_failure "${log_file}"; then
    rm -f "${log_file}"
    return "${status}"
  fi

  printf '%s\n' \
    'Docker BuildKit reported a missing cache lease; pruning BuildKit cache and retrying once.' \
    'If the retry also fails, inspect Docker daemon health and available disk space.' >&2
  docker buildx prune --all --force

  set +e
  "$@"
  retry_status=$?
  set -e
  rm -f "${log_file}"
  return "${retry_status}"
}

dotenv_value() {
  local key="$1"
  local value
  value="$(
    sed -n "s/^${key}=//p" "${ENV_FILE}" \
      | tail -n 1
  )"
  value="${value%$'\r'}"
  if [[ "${value}" == \"*\" && "${value}" == *\" ]]; then
    value="${value:1:${#value}-2}"
  elif [[ "${value}" == \'*\' && "${value}" == *\' ]]; then
    value="${value:1:${#value}-2}"
  fi
  printf '%s' "${value}"
}

environment_value() {
  local key="$1"
  if [[ -v "${key}" ]]; then
    printf '%s' "${!key}"
  else
    dotenv_value "${key}"
  fi
}

reject_database_environment_overrides() {
  local key configured
  for key in \
    DBS_MAPP ETL_DATABASE_URL POSTGRES_DB POSTGRES_USER POSTGRES_PASSWORD \
    ETL_DB_USER ETL_DB_PASSWORD XYZ_DB_USER XYZ_DB_PASSWORD \
    DERIVED_DB_USER DERIVED_DB_PASSWORD DERIVED_DATABASE_URL \
    DERIVED_READER_ROLE
  do
    if [[ -v "${key}" ]]; then
      configured="$(dotenv_value "${key}")"
      if [[ "${!key}" != "${configured}" ]]; then
        printf 'Exported %s conflicts with the authoritative value in %s; unset it or update the env file deliberately.\n' \
          "${key}" "${ENV_FILE}" >&2
        exit 2
      fi
    fi
  done
}

state_owner_error() {
  local expected_uid="$1"
  local expected_gid="$2"
  local path="${3:-${STATE_DIR}}"
  printf 'Writable state ownership does not match CONFIG_UID=%s and CONFIG_GID=%s: %s\n' \
    "${expected_uid}" "${expected_gid}" "${path}" >&2
  printf 'Repair it deliberately, for example: sudo chown -R %s:%s %q\n' \
    "${expected_uid}" "${expected_gid}" "${STATE_DIR}" >&2
  exit 2
}

check_state_owner() {
  local expected_uid expected_gid mismatch path
  expected_uid="$(environment_value CONFIG_UID)"
  expected_gid="$(environment_value CONFIG_GID)"
  if [[ ! "${expected_uid}" =~ ^[0-9]+$ || ! "${expected_gid}" =~ ^[0-9]+$ ]]; then
    printf 'CONFIG_UID and CONFIG_GID must be numeric.\n' >&2
    exit 2
  fi
  if [[ -e "${STATE_DIR}" ]]; then
    if [[ "$(stat -c %u "${STATE_DIR}")" != "${expected_uid}" \
      || "$(stat -c %g "${STATE_DIR}")" != "${expected_gid}" ]]; then
      state_owner_error "${expected_uid}" "${expected_gid}"
    fi
    mismatch="$(
      find "${STATE_DIR}" -xdev \
        \( ! -uid "${expected_uid}" -o ! -gid "${expected_gid}" \) \
        -print -quit 2>/dev/null || true
    )"
    if [[ -n "${mismatch}" ]]; then
      state_owner_error "${expected_uid}" "${expected_gid}" "${mismatch}"
    fi
  fi
  if [[ "$(id -u)" != "${expected_uid}" || "$(id -g)" != "${expected_gid}" ]]; then
    for path in \
      "${STATE_DIR}" \
      "${WORKSPACE_DIR}" \
      "${CONTROL_DIR}" \
      "${CONTROL_DIR}/artifacts" \
      "${CONTROL_DIR}/proposals" \
      "${SEMANTIC_DIR}" \
      "${RELOAD_DIR}" \
      "${PREVIEW_DIR}" \
      "${PREVIEW_RELOAD_DIR}"
    do
      if [[ ! -e "${path}" ]]; then
        state_owner_error "${expected_uid}" "${expected_gid}" "${path}"
      fi
    done
  fi
}

init_state() {
  umask 077
  mkdir -p \
    "${WORKSPACE_DIR}" \
    "${CONTROL_DIR}/artifacts" \
    "${CONTROL_DIR}/proposals" \
    "${SEMANTIC_DIR}" \
    "${RELOAD_DIR}" \
    "${PREVIEW_DIR}" \
    "${PREVIEW_RELOAD_DIR}"
  chmod 700 \
    "${STATE_DIR}" \
    "${WORKSPACE_DIR}" \
    "${CONTROL_DIR}" \
    "${CONTROL_DIR}/artifacts" \
    "${CONTROL_DIR}/proposals" \
    "${SEMANTIC_DIR}" \
    "${RELOAD_DIR}" \
    "${PREVIEW_DIR}" \
    "${PREVIEW_RELOAD_DIR}"

  if [[ ! -f "${WORKSPACE_DIR}/workspace.json" ]]; then
    if [[ ! -f "${ROOT_DIR}/instance/workspace.seed.json" ]]; then
      printf 'Missing workspace seed: %s/instance/workspace.seed.json\n' "${ROOT_DIR}" >&2
      exit 2
    fi
    cp "${ROOT_DIR}/instance/workspace.seed.json" "${WORKSPACE_DIR}/workspace.json"
    chmod 644 "${WORKSPACE_DIR}/workspace.json"
    printf 'Created live workspace from instance/workspace.seed.json.\n'
  fi
  if [[ ! -f "${PREVIEW_DIR}/workspace.json" ]]; then
    cp "${WORKSPACE_DIR}/workspace.json" "${PREVIEW_DIR}/workspace.json"
    chmod 600 "${PREVIEW_DIR}/workspace.json"
  fi
}

init_env() {
  init_state
  if [[ ! -f "${CONTROL_DIR}/auth.json" ]]; then
    command -v openssl >/dev/null 2>&1 || {
      printf 'openssl is required to generate the configuration administrator password.\n' >&2
      exit 127
    }
    admin_password="$(openssl rand -base64 24 | tr -d '\n' | tr '/+' '_-')"
    printf '%s\n' "${admin_password}" \
      | python3 "${ROOT_DIR}/config-ui/config_admin.py" init \
          --root "${CONTROL_DIR}" \
          --password-stdin
  fi
  if [[ -e "${ENV_FILE}" ]]; then
    printf 'Initialization skipped: %s already exists and was left unchanged.\n' "${ENV_FILE}"
    return
  fi

  if [[ ! -f "${ROOT_DIR}/.env.example" ]]; then
    printf 'Missing initialization template: %s/.env.example\n' "${ROOT_DIR}" >&2
    exit 2
  fi

  command -v openssl >/dev/null 2>&1 || {
    printf 'openssl is required to generate local passwords.\n' >&2
    exit 127
  }

  umask 077
  sed \
    -e "s/CHANGEME_POSTGRES/$(openssl rand -hex 24)/" \
    -e "s/CHANGEME_ETL/$(openssl rand -hex 24)/" \
    -e "s/CHANGEME_XYZ/$(openssl rand -hex 24)/" \
    -e "s/CHANGEME_DERIVED/$(openssl rand -hex 24)/" \
    -e "s/CHANGEME_SEMANTIC/$(openssl rand -hex 32)/" \
    -e "s/^CONFIG_UID=.*/CONFIG_UID=$(id -u)/" \
    -e "s/^CONFIG_GID=.*/CONFIG_GID=$(id -g)/" \
    "${ROOT_DIR}/.env.example" >"${ENV_FILE}"
  chmod 600 "${ENV_FILE}"
  printf 'Created %s with URL-safe local passwords.\n' "${ENV_FILE}"
}

if [[ "${1:-}" == "init" ]]; then
  init_env
  exit 0
fi

if [[ "${1:-}" == "doctor" ]]; then
  python3 "${ROOT_DIR}/scripts/check_env.py" \
    --example "${ROOT_DIR}/.env.example" \
    --environment "${ENV_FILE}" \
    "${@:2}"
  PLUGIN_DIR="${ROOT_DIR}/instance/public/plugins" \
    PYTHONPATH="${ROOT_DIR}/config-ui" \
    python3 -c 'from plugin_registry import catalogue; import sys; result = catalogue(); print("Plugin catalogue {}: {} external plugin(s).".format(result["fingerprint"][:12], len(result["external"]))); sys.exit(0 if result["valid"] else 1)'
  exit $?
fi

if [[ "${1:-}" == "production-acceptance" ]]; then
  python3 "${ROOT_DIR}/scripts/production_acceptance.py" \
    --environment "${ENV_FILE}" \
    "${@:2}"
  exit $?
fi

if [[ "${1:-}" == "cleanup-temp" ]]; then
  python3 "${ROOT_DIR}/scripts/cleanup_temp.py" \
    --state-dir "${STATE_DIR}" \
    "${@:2}"
  exit $?
fi

require_docker

if [[ ! -f "${ENV_FILE}" ]]; then
  printf 'Missing %s. Run ./bin/mapp init first.\n' "${ENV_FILE}" >&2
  exit 2
fi
reject_database_environment_overrides
check_state_owner
init_state
check_state_owner
if [[ ! -f "${CONTROL_DIR}/auth.json" ]]; then
  printf 'Configuration authentication is not initialized. Run ./bin/mapp init.\n' >&2
  exit 2
fi

compose=(
  docker compose
  --project-directory "${ROOT_DIR}"
  --env-file "${ENV_FILE}"
  --file "${ROOT_DIR}/compose.yaml"
)
database_mode="$(dotenv_value MAPP_DATABASE_MODE)"
if [[ -v MAPP_DATABASE_MODE && "${MAPP_DATABASE_MODE}" != "${database_mode}" ]]; then
  printf 'Exported MAPP_DATABASE_MODE conflicts with the authoritative value in %s; unset it or update the env file deliberately.\n' \
    "${ENV_FILE}" >&2
  exit 2
fi
case "${database_mode}" in
  bundled)
    compose+=(--file "${ROOT_DIR}/compose.bundled-db.yaml")
    runtime_services=(db semantic-service xyz xyz-preview config-ui browser-runner egress-proxy caddy)
    ;;
  external)
    runtime_services=(semantic-service xyz xyz-preview config-ui browser-runner egress-proxy caddy)
    ;;
  *)
    printf 'MAPP_DATABASE_MODE must be bundled or external.\n' >&2
    exit 2
    ;;
esac
deployment_environment="$(dotenv_value MAPP_ENVIRONMENT)"
if [[ -v MAPP_ENVIRONMENT && "${MAPP_ENVIRONMENT}" != "${deployment_environment}" ]]; then
  printf 'Exported MAPP_ENVIRONMENT conflicts with the authoritative value in %s; unset it or update the env file deliberately.\n' \
    "${ENV_FILE}" >&2
  exit 2
fi
case "${deployment_environment}" in
  development)
    ;;
  production)
    python3 "${ROOT_DIR}/scripts/validate_production_env.py" \
      --environment "${ENV_FILE}"
    compose+=(--file "${ROOT_DIR}/compose.production.yaml")
    ;;
  *)
    printf 'MAPP_ENVIRONMENT must be development or production.\n' >&2
    exit 2
    ;;
esac
if [[ "${database_mode}" == "external" ]]; then
  resolved_dbs="$(
    "${compose[@]}" config --format json \
      | python3 -c 'import json, sys; print(json.load(sys.stdin)["services"]["xyz"]["environment"]["DBS_MAPP"], end="")'
  )"
  printf '%s' "${resolved_dbs}" \
    | python3 "${ROOT_DIR}/scripts/validate_database_url.py"
fi

run_sample_etl() {
  run_with_buildkit_lease_retry "${compose[@]}" run --rm --build etl
}

run_census_etl() {
  run_with_buildkit_lease_retry "${compose[@]}" run --rm --build etl \
    python -m leeds_arcgis_etl.census_main \
    --config /config/census.json
}

prepare_spatial_indexes() {
  "${compose[@]}" exec -T db sh /usr/local/bin/mapp-prepare-spatial-indexes
}

run_all_etl() {
  run_sample_etl
  prepare_spatial_indexes
  run_census_etl
  prepare_spatial_indexes
}

case "${1:-}" in
  up|serve)
    run_with_buildkit_lease_retry "${compose[@]}" up --detach --build "${runtime_services[@]}"
    ;;
  config-ui)
    run_with_buildkit_lease_retry "${compose[@]}" up --detach --build "${runtime_services[@]}"
    ;;
  config-ui-down)
    "${compose[@]}" rm --stop --force config-ui
    ;;
  reload-xyz)
    "${compose[@]}" exec -T config-ui python -c \
      'from app import WORKSPACE; from control_api import request_reload, wait_reload, workspace_fingerprint; fingerprint = workspace_fingerprint(WORKSPACE.read_bytes()); result = request_reload(fingerprint); status = wait_reload(result["requestedGeneration"], fingerprint); completed = status["completed"]; print("XYZ reload generation {} {} for workspace {}.".format(result["requestedGeneration"], "completed" if completed else "did not complete", fingerprint)); raise SystemExit(0 if completed else 1)'
    ;;
  etl)
    if [[ "${database_mode}" != "bundled" ]]; then
      printf './bin/mapp etl is bundled data provisioning and is disabled when MAPP_DATABASE_MODE=external.\n' >&2
      exit 2
    fi
    if [[ -n "${2:-}" ]]; then
      run_with_buildkit_lease_retry "${compose[@]}" run --rm --build -e "ETL_LAYER=${2}" etl
      prepare_spatial_indexes
    else
      run_all_etl
    fi
    ;;
  census-etl)
    if [[ "${database_mode}" != "bundled" ]]; then
      printf './bin/mapp census-etl is optional data provisioning and is disabled when MAPP_DATABASE_MODE=external.\n' >&2
      exit 2
    fi
    if [[ -n "${2:-}" ]]; then
      printf 'Usage: ./bin/mapp census-etl\n' >&2
      exit 2
    fi
    run_census_etl
    prepare_spatial_indexes
    ;;
  census-check)
    if [[ "${database_mode}" != "bundled" ]]; then
      printf './bin/mapp census-check is available only with the bundled ETL tool image.\n' >&2
      exit 2
    fi
    if [[ -n "${3:-}" ]]; then
      printf 'Usage: ./bin/mapp census-check [topic]\n' >&2
      exit 2
    fi
    census_check_args=(
      python -m leeds_arcgis_etl.census_main
      --config /config/census.json
      --check-source
    )
    if [[ -n "${2:-}" ]]; then
      census_check_args+=(--topic "${2}")
    fi
    run_with_buildkit_lease_retry "${compose[@]}" run --rm --build etl "${census_check_args[@]}"
    ;;
  recover-reset-data)
    if [[ "${database_mode}" != "bundled" ]]; then
      printf './bin/mapp recover-reset-data is available only when MAPP_DATABASE_MODE=bundled.\n' >&2
      exit 2
    fi
    if [[ "${2:-}" != "--confirm" || -n "${3:-}" ]]; then
      printf '%s\n' \
        'This force-recovers a retained bundled database from an interrupted reset-data operation.' \
        'Confirm that no reset-data process is still running, then run ./bin/mapp recover-reset-data --confirm.' >&2
      exit 2
    fi
    printf 'Starting the private control plane for explicit interrupted-reset recovery.\n'
    run_with_buildkit_lease_retry "${compose[@]}" up --detach --build --wait db semantic-service config-ui
    "${compose[@]}" exec -T config-ui python -c \
      'import json; from app import recover_interrupted_reset_semantics; print(json.dumps(recover_interrupted_reset_semantics(force=True, wait_for_ready=True), separators=(",", ":")))'
    ;;
  reset-data)
    if [[ "${database_mode}" != "bundled" ]]; then
      printf './bin/mapp reset-data is available only when MAPP_DATABASE_MODE=bundled.\n' >&2
      exit 2
    fi
    if [[ "${2:-}" != "--confirm" || -n "${3:-}" ]]; then
      printf '%s\n' \
        'This permanently removes the bundled PostgreSQL database, including derived layers and any non-ETL tables.' \
        'Active derived semantic profiles are archived first. The live workspace is replaced by instance/workspace.seed.json; dashboard authentication, audit records, proposals, semantic history, and public assets are preserved.' \
        'Run ./bin/mapp reset-data --confirm to continue.' >&2
      exit 2
    fi
    database_volume="$(
      "${compose[@]}" config --format json \
        | python3 -c 'import json, sys; print(json.load(sys.stdin)["volumes"]["postgres_data"]["name"], end="")'
    )"
    reset_gate_may_be_owned=0
    reset_gate_owner="$(
      python3 -c 'import uuid; print(uuid.uuid4())'
    )"
    recover_interrupted_reset() {
      local reset_status="$1"
      trap - ERR INT TERM
      if [[ "${reset_gate_may_be_owned}" == "1" ]]; then
        printf 'Reset stopped after semantic archival began; checking its owned maintenance gate for compensation.\n' >&2
        set +e
        local recovery_volume_inspection=""
        if recovery_volume_inspection="$(docker volume inspect "${database_volume}" 2>&1)"; then
          "${compose[@]}" up --detach --no-build --wait db semantic-service config-ui
          local start_status=$?
          if [[ "${start_status}" == "0" ]]; then
            "${compose[@]}" exec -T \
              -e "MAPP_RESET_GATE_OWNER=${reset_gate_owner}" \
              config-ui python -c \
              'import json, os; from app import recover_interrupted_reset_semantics; print(json.dumps(recover_interrupted_reset_semantics(reset_owner=os.environ["MAPP_RESET_GATE_OWNER"], wait_for_ready=True), separators=(",", ":")))'
            local recovery_status=$?
            if [[ "${recovery_status}" != "0" ]]; then
              printf 'Owned semantic reset recovery failed; keep the database volume, confirm no reset-data process is active, then run ./bin/mapp recover-reset-data --confirm.\n' >&2
            fi
          else
            printf 'The control plane could not restart for semantic reset recovery; keep the database volume, confirm no reset-data process is active, then run ./bin/mapp recover-reset-data --confirm.\n' >&2
          fi
        elif [[ "${recovery_volume_inspection}" == *"No such volume"* ]]; then
          printf 'The bundled database volume was already removed; semantic compensation is no longer safe. Run reset-data --confirm again to finish initialization.\n' >&2
        else
          printf 'The bundled database volume state could not be verified; no semantic compensation was attempted. Inspect Docker state before explicit recovery.\n' >&2
        fi
        set -e
      fi
      exit "${reset_status}"
    }
    trap 'recover_interrupted_reset $?' ERR
    trap 'recover_interrupted_reset 130' INT
    trap 'recover_interrupted_reset 143' TERM
    printf 'Starting the private control plane to archive derived semantic profiles.\n'
    run_with_buildkit_lease_retry "${compose[@]}" up --detach --build --wait db semantic-service config-ui
    reset_gate_may_be_owned=1
    "${compose[@]}" exec -T \
      -e "MAPP_RESET_GATE_OWNER=${reset_gate_owner}" \
      config-ui python -c \
      'import json, os; from app import archive_derived_semantics_before_reset; print(json.dumps(archive_derived_semantics_before_reset(os.environ["MAPP_RESET_GATE_OWNER"]), separators=(",", ":")))'
    printf 'Derived semantic profiles are archived; proceeding with the confirmed reset.\n'
    printf 'Stopping the platform before removing bundled database volume %s.\n' "${database_volume}"
    "${compose[@]}" down
    volume_inspection=""
    if volume_inspection="$(docker volume inspect "${database_volume}" 2>&1)"; then
      docker volume rm "${database_volume}"
      reset_gate_may_be_owned=0
    elif [[ "${volume_inspection}" == *"No such volume"* ]]; then
      printf 'Bundled database volume did not exist; a new one will be initialized.\n'
      reset_gate_may_be_owned=0
    else
      printf 'Could not verify the bundled database volume; leaving reset compensation active.\n' >&2
      false
    fi
    trap - ERR INT TERM
    install -m 0644 "${ROOT_DIR}/instance/workspace.seed.json" "${WORKSPACE_DIR}/workspace.json"
    install -m 0600 "${ROOT_DIR}/instance/workspace.seed.json" "${PREVIEW_DIR}/workspace.json"
    printf 'Reset live and preview workspaces from instance/workspace.seed.json.\n'
    run_with_buildkit_lease_retry "${compose[@]}" up --detach --build "${runtime_services[@]}"
    run_all_etl
    "${ROOT_DIR}/scripts/verify.sh"
    printf '%s\n' \
      'Bundled database reset completed, all configured ETL sources including Census were loaded, and the seed workspace was restored.'
    ;;
  upgrade-derived)
    if [[ "${database_mode}" != "bundled" ]]; then
      printf './bin/mapp upgrade-derived is available only for the bundled database; provision external roles and extensions with your database administrator.\n' >&2
      exit 2
    fi
    run_with_buildkit_lease_retry "${compose[@]}" build db
    "${compose[@]}" up --detach --no-deps --wait db
    "${compose[@]}" exec -T db sh /usr/local/bin/mapp-upgrade-derived
    prepare_spatial_indexes
    ;;
  all)
    if [[ "${database_mode}" != "bundled" ]]; then
      printf './bin/mapp all includes bundled ETL data and is available only when MAPP_DATABASE_MODE=bundled. Use serve, then verify, for an external database.\n' >&2
      exit 2
    fi
    run_with_buildkit_lease_retry "${compose[@]}" up --detach --build "${runtime_services[@]}"
    run_all_etl
    "${ROOT_DIR}/scripts/verify.sh"
    ;;
  verify)
    "${ROOT_DIR}/scripts/verify.sh"
    ;;
  test)
    run_with_buildkit_lease_retry "${compose[@]}" build config-ui semantic-service
    run_with_buildkit_lease_retry docker build --tag mapp-leeds-etl:local "${ROOT_DIR}/etl"
    docker run --rm \
      --volume "${ROOT_DIR}:/workspace:ro" \
      --env PYTHONPATH=/app \
      mapp-config-ui:local \
      python -m unittest discover -s /workspace/config-ui/tests -v
    docker run --rm \
      --volume "${ROOT_DIR}/semantic-service:/workspace:ro" \
      --workdir /workspace \
      --env PYTHONDONTWRITEBYTECODE=1 \
      mapp-semantic-service:local \
      python -m unittest discover -s tests -v
    docker run --rm \
      --volume "${ROOT_DIR}:/workspace:ro" \
      --env PYTHONPATH=/app/src \
      mapp-leeds-etl:local \
      python -m unittest discover -s /workspace/etl/tests -v
    PYTHONPATH="${ROOT_DIR}" \
      python3 -m unittest discover -s "${ROOT_DIR}/scripts/tests" -v
    docker run --rm \
      --volume "${ROOT_DIR}:/source:ro" \
      --workdir /tmp \
      "${NODE_IMAGE:-node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3}" \
      sh -c '
        cp -a /source/config-ui /tmp/config-ui
        cd /tmp/config-ui
        npm ci
        npm test
        npm run build
        npm audit --omit=dev
        node --check /source/docker/xyz/supervisor.mjs
        node --check /source/browser-runner/server.mjs
      '
    run_with_buildkit_lease_retry "${compose[@]}" build egress-proxy
    PYTHONDONTWRITEBYTECODE=1 python3 "${ROOT_DIR}/scripts/test_egress_proxy.py"
    "${compose[@]}" config --quiet
    docker compose \
      --project-directory "${ROOT_DIR}" \
      --env-file "${ROOT_DIR}/.env.example" \
      --file "${ROOT_DIR}/compose.yaml" \
      config --quiet
    docker compose \
      --project-directory "${ROOT_DIR}" \
      --env-file "${ROOT_DIR}/.env.example" \
      --file "${ROOT_DIR}/compose.yaml" \
      --file "${ROOT_DIR}/compose.bundled-db.yaml" \
      config --quiet
    printf 'Unit tests, semantic-service tests, and bundled/external Compose validation passed.\n'
    ;;
  config)
    "${compose[@]}" config --quiet
    printf 'Compose configuration is valid.\n'
    ;;
  build-xyz)
    run_with_buildkit_lease_retry "${compose[@]}" build --pull xyz
    ;;
  ps)
    "${compose[@]}" ps
    ;;
  logs)
    "${compose[@]}" logs --follow --tail 200
    ;;
  db)
    if [[ "${database_mode}" != "bundled" ]]; then
      printf './bin/mapp db is available only for the bundled sample database. Use an approved PostgreSQL client for the external service.\n' >&2
      exit 2
    fi
    postgres_user="$(environment_value POSTGRES_USER)"
    postgres_db="$(environment_value POSTGRES_DB)"
    "${compose[@]}" exec db psql --username "${postgres_user}" --dbname "${postgres_db}"
    ;;
  reset-config-password)
    "${compose[@]}" run --rm --no-deps config-ui \
      python config_admin.py reset-password --root /control
    ;;
  revoke-config-tokens)
    "${compose[@]}" run --rm --no-deps config-ui \
      python config_admin.py revoke-tokens --root /control
    ;;
  stop)
    "${compose[@]}" stop
    ;;
  down)
    "${compose[@]}" down
    ;;
  *)
    usage
    exit 2
    ;;
esac
