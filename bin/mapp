if [[ ! -f "${ENV_FILE}" ]]; then
  printf 'Missing %s. Run ./bin/mapp init first.\n' "${ENV_FILE}" >&2
  exit 2
fi
require_federation_settings
require_docker
reject_database_environment_overrides
case "${1:-}" in
  up|serve|config-ui|reset-system|all)
    clear_edge_environment_overrides
    ;;
esac
check_state_owner
init_state
check_state_owner
# There is no file to test any more: the administrator credential lives in the
# control schema. Gating every compose subcommand on a database query would be
# worse than useless -- `down`, `ps`, `logs` and `stop` all have to work when
# the database is stopped, which is exactly when such a check would fail. The
# .env check above already catches a system that never ran init, and an
# uninitialized control plane surfaces at the login prompt with the message
# from ControlStore rather than here.

compose=(
  docker compose
  --project-directory "${ROOT_DIR}"
  --env-file "${ENV_FILE}"
  --file "${ROOT_DIR}/compose.yaml"
)
compose+=(--file "${ROOT_DIR}/compose.bundled-db.yaml")
runtime_services=(db semantic-service xyz xyz-preview config-ui browser-runner egress-proxy caddy)
# The MCP surface is opt-in. `MAPP_MCP=1 ./bin/mapp all` starts the
# authorization broker and the agent runtime; without it neither is built or
# run, and a deployment that never issues an agent credential does not carry an
# OAuth server it does not use. Naming a profiled service on the command line
# would start it regardless of the profile, so the services are added to the
# list here rather than left in it unconditionally.
# Read from the shell first and .env second, so it can be turned on for one
# command or set once for the deployment. It used to be shell-only, which made
# it the odd one out beside MAPP_DEMO_SOURCES and meant `MAPP_MCP=1` in .env
# silently started nothing.
mcp_surface="${MAPP_MCP:-$(dotenv_value MAPP_MCP)}"
if [[ "${mcp_surface}" == "1" ]]; then
  compose+=(--profile mcp)
  runtime_services+=(mcp-auth mapp-mcp)
fi
# An overlay that carries FEDERATION_DBS_<REF> entries must be applied whenever
# an alias using them could be registered, or recreating config-ui silently
# strips the reference and the periodic verifier withdraws that source. One
# rule, applied to both opt-in overlays.
#
# The demo overlay also starts its two databases, because turning the demo on
# means running it. The federation-test rig does not: its source-db is started
# by ./bin/mapp federation-test alone, so this only carries its reference
# through to config-ui.
#
# Deliberately NOT added to the exported-value conflict guard that
# MAPP_ENVIRONMENT uses: no compose file interpolates MAPP_DEMO_SOURCES, so an
# exported value cannot reach the resolved model.
demo_sources="$(dotenv_value MAPP_DEMO_SOURCES)"
if [[ -n "${demo_sources}" ]]; then
  compose+=(--file "${ROOT_DIR}/compose.federated-demo.yaml")
  runtime_services+=(census-db ops-db)
fi
if [[ -n "$(dotenv_value FEDERATION_DBS_LEEDS_EXT)" ]]; then
  compose+=(--file "${ROOT_DIR}/compose.federation-test.yaml")
fi
deployment_environment="$(dotenv_value MAPP_ENVIRONMENT)"
if [[ -v MAPP_ENVIRONMENT && "${MAPP_ENVIRONMENT}" != "${deployment_environment}" ]]; then
  printf 'Exported MAPP_ENVIRONMENT conflicts with the authoritative value in %s; unset it or update the env file deliberately.\n' \
    "${ENV_FILE}" >&2
  exit 2
fi
case "${deployment_environment}" in
  development)
    ;;
  production)
    python3 "${ROOT_DIR}/scripts/validate_production_env.py" \
      --environment "${ENV_FILE}"
    compose+=(--file "${ROOT_DIR}/compose.production.yaml")
    ;;
  *)
    printf 'MAPP_ENVIRONMENT must be development or production.\n' >&2
    exit 2
    ;;
esac
prepare_spatial_indexes() {
  "${compose[@]}" exec -T db sh /usr/local/bin/mapp-prepare-spatial-indexes
}

ensure_bundled_database_upgraded() {
  run_with_buildkit_lease_retry \
    "${compose[@]}" up --detach --build --no-deps --wait db
  "${compose[@]}" exec -T db sh /usr/local/bin/mapp-upgrade-derived
}

edge_bindings() {
  local source="$1"
  python3 -c '
import json
import sys

source = sys.argv[1]
payload = json.load(sys.stdin)
bindings = []
if source == "compose":
    for port in payload["services"]["caddy"].get("ports", []):
        protocol = port.get("protocol", "tcp")
        host_ip = port.get("host_ip") or "0.0.0.0"
        bindings.append(
            "{}:{}->{}/{}".format(
                host_ip, port["published"], port["target"], protocol
            )
        )
else:
    for container in payload:
        for target, published in container["NetworkSettings"]["Ports"].items():
            for binding in published or []:
                bindings.append(
                    "{}:{}->{}".format(
                        binding["HostIp"], binding["HostPort"], target
                    )
                )
print("\n".join(sorted(bindings)))
' "${source}"
}

ensure_caddy_bindings() {
  local expected actual container_id
  expected="$("${compose[@]}" config --format json | edge_bindings compose)"
  container_id="$("${compose[@]}" ps --quiet caddy)"
  if [[ -z "${container_id}" ]]; then
    printf 'Caddy did not start, so its published edge bindings could not be verified.\n' >&2
    return 1
  fi
  actual="$(docker inspect "${container_id}" | edge_bindings inspect)"
  if [[ "${actual}" == "${expected}" ]]; then
    return 0
  fi

  printf '%s\n' \
    'The running Caddy port bindings differ from the reviewed Compose configuration.' \
    'Recreating only Caddy to apply the configured edge address and ports.' >&2
  "${compose[@]}" up --detach --no-deps --force-recreate caddy

  container_id="$("${compose[@]}" ps --quiet caddy)"
  actual="$(docker inspect "${container_id}" | edge_bindings inspect)"
  if [[ "${actual}" != "${expected}" ]]; then
    printf 'Caddy port bindings still differ after recreation. Expected:\n%s\nActual:\n%s\n' \
      "${expected}" "${actual}" >&2
    return 1
  fi
}

case "${1:-}" in
  up|serve)
    case "${2:-}" in
      "")
        ensure_bundled_database_upgraded
        run_with_buildkit_lease_retry "${compose[@]}" up --detach --build "${runtime_services[@]}"
        ;;
      --force-recreate)
        if [[ -n "${3:-}" ]]; then
          printf 'Usage: ./bin/mapp %s [--force-recreate]\n' "$1" >&2
          exit 2
        fi
        ensure_bundled_database_upgraded
        run_with_buildkit_lease_retry "${compose[@]}" up --detach --build --force-recreate "${runtime_services[@]}"
        ;;
      *)
        printf 'Usage: ./bin/mapp %s [--force-recreate]\n' "$1" >&2
        exit 2
        ;;
    esac
    # The administrator credential lives in the control schema, so a platform
    # that gains the control plane -- an existing volume upgraded rather than
    # created -- comes up with nowhere to sign in and no command to fix it:
    # bootstrap ran only from `init`, which rewrites .env, and from
    # `reset-system`, which destroys the database. Neither is something an
    # operator should have to do to adopt a schema migration.
    #
    # Safe on every start because `config_admin init` refuses to overwrite an
    # existing credential and says so, and report_admin_bootstrap prints a
    # password only when one was actually minted.
    bootstrap_admin_credential ""
    ensure_runtime_client_registered
    ensure_caddy_bindings
    ;;
  config-ui)
    ensure_bundled_database_upgraded
    run_with_buildkit_lease_retry "${compose[@]}" up --detach --build "${runtime_services[@]}"
    ensure_caddy_bindings
    ;;
  config-ui-down)
    "${compose[@]}" rm --stop --force config-ui
    ;;
  reload-xyz)
    "${compose[@]}" exec -T config-ui python -c \
      'from app import WORKSPACE; from control_api import request_reload, wait_reload, workspace_fingerprint; fingerprint = workspace_fingerprint(WORKSPACE.read_bytes()); result = request_reload(fingerprint); status = wait_reload(result["requestedGeneration"], fingerprint); completed = status["completed"]; print("XYZ reload generation {} {} for workspace {}.".format(result["requestedGeneration"], "completed" if completed else "did not complete", fingerprint)); raise SystemExit(0 if completed else 1)'
    ;;
  census-check)
    if [[ -n "${3:-}" ]]; then
      printf 'Usage: ./bin/mapp census-check [topic]\n' >&2
      exit 2
    fi
    census_check_args=(
      python -m leeds_arcgis_etl.census_main
      --config /config/census.json
      --check-source
    )
    if [[ -n "${2:-}" ]]; then
      census_check_args+=(--topic "${2}")
    fi
    # --no-deps: the check reads the publisher over the network and never
    # touches a database, but the etl service declares depends_on db, so
    # without this it starts the packaged PostgreSQL to validate a remote
    # source.
    run_with_buildkit_lease_retry "${compose[@]}" run --rm --build --no-deps \
      etl "${census_check_args[@]}"
    ;;
  recover-reset-system)
    if [[ "${2:-}" != "--confirm" || -n "${3:-}" ]]; then
      printf '%s\n' \
        'This force-recovers a retained bundled database from an interrupted reset-system operation.' \
        'Confirm that no reset-system process is still running, then run ./bin/mapp recover-reset-system --confirm.' >&2
      exit 2
    fi
    printf 'Starting the private control plane for explicit interrupted-reset recovery.\n'
    run_with_buildkit_lease_retry "${compose[@]}" up --detach --build --wait db semantic-service config-ui
    "${compose[@]}" exec -T config-ui python -c \
      'import json; from app import recover_interrupted_reset_semantics; print(json.dumps(recover_interrupted_reset_semantics(force=True, wait_for_ready=True), separators=(",", ":")))'
    ;;
  reset-system)
    if [[ "${2:-}" != "--confirm" || -n "${3:-}" ]]; then
      printf '%s\n' \
        'This permanently removes the packaged PostgreSQL database and everything in it: derived layers, the federation registry and its group labels, and the whole semantic catalogue -- generated profiles, curated meaning, semantic proposals and their history.' \
        'Back the database up first if any of that matters. Active derived semantic profiles are archived beforehand, but archival records the state, it does not survive the volume.' \
        'Destroys: the packaged database volume, and with it dashboard authentication, every CLI API token, every device authorization, every registered MCP agent client and every consent those agents hold. Authentication is reinitialized afterwards and a new administrator password is printed, leaving the platform as ./bin/mapp init leaves it; agent clients have to be registered again and their operators have to consent again.' \
        'Not touched: the source databases holding the spatial data, and the audit log, workspace proposals, artifacts and public assets under var. The live workspace is replaced by instance/workspace.seed.json.' \
        'Run ./bin/mapp reset-system --confirm to continue.' >&2
      exit 2
    fi
    database_volume="$(
      "${compose[@]}" config --format json \
        | python3 -c 'import json, sys; print(json.load(sys.stdin)["volumes"]["postgres_data"]["name"], end="")'
    )"
    reset_gate_may_be_owned=0
    reset_gate_owner="$(
      python3 -c 'import uuid; print(uuid.uuid4())'
    )"
    recover_interrupted_reset() {
      local reset_status="$1"
      trap - ERR INT TERM
      if [[ "${reset_gate_may_be_owned}" == "1" ]]; then
        printf 'Reset stopped after semantic archival began; checking its owned maintenance gate for compensation.\n' >&2
        set +e
        local recovery_volume_inspection=""
        if recovery_volume_inspection="$(docker volume inspect "${database_volume}" 2>&1)"; then
          "${compose[@]}" up --detach --no-build --wait db semantic-service config-ui
          local start_status=$?
          if [[ "${start_status}" == "0" ]]; then
            "${compose[@]}" exec -T \
              -e "MAPP_RESET_GATE_OWNER=${reset_gate_owner}" \
              config-ui python -c \
              'import json, os; from app import recover_interrupted_reset_semantics; print(json.dumps(recover_interrupted_reset_semantics(reset_owner=os.environ["MAPP_RESET_GATE_OWNER"], wait_for_ready=True), separators=(",", ":")))'
            local recovery_status=$?
            if [[ "${recovery_status}" != "0" ]]; then
              printf 'Owned semantic reset recovery failed; keep the database volume, confirm no reset-system process is active, then run ./bin/mapp recover-reset-system --confirm.\n' >&2
            fi
          else
            printf 'The control plane could not restart for semantic reset recovery; keep the database volume, confirm no reset-system process is active, then run ./bin/mapp recover-reset-system --confirm.\n' >&2
          fi
        elif [[ "${recovery_volume_inspection}" == *"No such volume"* ]]; then
          printf 'The bundled database volume was already removed; semantic compensation is no longer safe. Run reset-system --confirm again to finish initialization.\n' >&2
        else
          printf 'The bundled database volume state could not be verified; no semantic compensation was attempted. Inspect Docker state before explicit recovery.\n' >&2
        fi
        set -e
      fi
      exit "${reset_status}"
    }
    trap 'recover_interrupted_reset $?' ERR
    trap 'recover_interrupted_reset 130' INT
    trap 'recover_interrupted_reset 143' TERM
    # Every runtime image is built before anything is destroyed. The rebuild
    # after the volume goes used to be the first time some of these were
    # built, so a build failure that had nothing to do with the reset -- a
    # withdrawn distribution package, say, which is exactly what happened --
    # left the deployment deleted and half-rebuilt. Discovering it here costs
    # a few minutes; discovering it after costs the database.
    printf 'Building every runtime image before anything is removed.\n'
    run_with_buildkit_lease_retry "${compose[@]}" build "${runtime_services[@]}"
    printf 'Starting the private control plane to archive derived semantic profiles.\n'
    run_with_buildkit_lease_retry "${compose[@]}" up --detach --no-build --wait db semantic-service config-ui
    reset_gate_may_be_owned=1
    "${compose[@]}" exec -T \
      -e "MAPP_RESET_GATE_OWNER=${reset_gate_owner}" \
      config-ui python -c \
      'import json, os; from app import archive_derived_semantics_before_reset; print(json.dumps(archive_derived_semantics_before_reset(os.environ["MAPP_RESET_GATE_OWNER"]), separators=(",", ":")))'
    printf 'Derived semantic profiles are archived; proceeding with the confirmed reset.\n'
    printf 'Stopping the platform before removing bundled database volume %s.\n' "${database_volume}"
    "${compose[@]}" down
    volume_inspection=""
    if volume_inspection="$(docker volume inspect "${database_volume}" 2>&1)"; then
      docker volume rm "${database_volume}"
      reset_gate_may_be_owned=0
    elif [[ "${volume_inspection}" == *"No such volume"* ]]; then
      printf 'Bundled database volume did not exist; a new one will be initialized.\n'
      reset_gate_may_be_owned=0
    else
      printf 'Could not verify the bundled database volume; leaving reset compensation active.\n' >&2
      false
    fi
    trap - ERR INT TERM
    install -m 0644 "${ROOT_DIR}/instance/workspace.seed.json" "${WORKSPACE_DIR}/workspace.json"
    install -m 0600 "${ROOT_DIR}/instance/workspace.seed.json" "${PREVIEW_DIR}/workspace.json"
    printf 'Reset live and preview workspaces from instance/workspace.seed.json.\n'
    # --no-build: everything was built before the destructive boundary above.
    "${compose[@]}" up --detach --no-build "${runtime_services[@]}"
    # The administrator credential, API tokens and device authorizations lived
    # in the volume that was just destroyed, so the platform comes back with no
    # way to sign in. Re-bootstrapping here is what makes reset-system mean
    # "return to a freshly initialized system" rather than "lock yourself out":
    # the new password is printed exactly as ./bin/mapp init prints it.
    bootstrap_admin_credential ""
    "${ROOT_DIR}/scripts/verify.sh"
    printf '%s\n' \
      'Database reset completed and the seed workspace was restored. The platform is back at its initial state: authentication was reinitialized and the new administrator password is shown above. Spatial data lives in the source databases; reload it with ./bin/mapp demo.'
    ;;
  upgrade-derived)
    run_with_buildkit_lease_retry "${compose[@]}" build db
    "${compose[@]}" up --detach --no-deps --wait db
    "${compose[@]}" exec -T db sh /usr/local/bin/mapp-upgrade-derived
    ;;
  all)
    ensure_bundled_database_upgraded
    run_with_buildkit_lease_retry "${compose[@]}" up --detach --build "${runtime_services[@]}"
    ensure_runtime_client_registered
    "${ROOT_DIR}/scripts/verify.sh"
    ;;
  verify)
    "${ROOT_DIR}/scripts/verify.sh"
    ;;
  demo)
    if [[ -z "${demo_sources}" ]]; then
      printf 'Set MAPP_DEMO_SOURCES first, with ./bin/mapp init --demo.\n' >&2
      exit 2
    fi
    demo_semantics=1
    case "${2:-}" in
      "") ;;
      --no-semantics) demo_semantics=0 ;;
      *)
        printf 'Usage: ./bin/mapp demo [--no-semantics]\n' >&2
        exit 2
        ;;
    esac
    if [[ -n "${3:-}" ]]; then
      printf 'Usage: ./bin/mapp demo [--no-semantics]\n' >&2
      exit 2
    fi
    "${ROOT_DIR}/docker/demo-sources/seed.sh"
    MAPP_DEMO_SEMANTICS="${demo_semantics}" \
      "${ROOT_DIR}/docker/demo-sources/layers.sh"
    ;;
  federation-test)
    "${ROOT_DIR}/scripts/federation-e2e.sh"
    ;;
  test)
    run_with_buildkit_lease_retry "${compose[@]}" build config-ui semantic-service mcp-auth
    run_with_buildkit_lease_retry docker build --tag mapp-leeds-etl:local "${ROOT_DIR}/etl"
    # The configuration suite now needs a database for the same reason the
    # semantic one does: the administrator credential, API tokens and device
    # authorizations live in the control schema, and a mocked cursor cannot
    # fail the way PostgreSQL fails. Run under `compose run` rather than a bare
    # `docker run`, which has no network and so could not reach a database at
    # all -- every one of those tests would skip and the run would still say OK.
    run_with_buildkit_lease_retry "${compose[@]}" up --detach --build --wait db
    "${compose[@]}" exec -T db sh -c \
      'exec psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" \
        --set ON_ERROR_STOP=1 \
        --command "DROP DATABASE IF EXISTS mapp_control_test" \
        --command "CREATE DATABASE mapp_control_test"' >/dev/null
    "${compose[@]}" exec -T db sh -c \
      'exec psql --username "$POSTGRES_USER" --dbname mapp_control_test \
        --set ON_ERROR_STOP=1 --command "CREATE SCHEMA control"' >/dev/null
    control_test_url="postgresql://$(dotenv_value POSTGRES_USER):$(dotenv_value POSTGRES_PASSWORD)@db:5432/mapp_control_test?sslmode=disable"
    config_ui_log="$(mktemp)"
    if ! "${compose[@]}" run --rm --build --no-deps \
      --volume "${ROOT_DIR}:/workspace:ro" \
      --env PYTHONPATH=/app \
      --env "CONTROL_TEST_DATABASE_URL=${control_test_url}" \
      --env "MAPP_BOOTSTRAP_DATABASE_URL=${control_test_url}" \
      --env "MAPP_DRAFT_TEST_DSN=${control_test_url}" \
      config-ui \
      python -m unittest discover -s /workspace/config-ui/tests -v 2>&1 \
      | tee "${config_ui_log}"; then
      rm -f "${config_ui_log}"
      exit 1
    fi
    # A skip here is the failure this guard exists to catch.
    if grep -q "skipped=" "${config_ui_log}"; then
      rm -f "${config_ui_log}"
      printf 'Configuration service tests skipped; the control-plane suite must run against PostgreSQL.\n' >&2
      exit 1
    fi
    rm -f "${config_ui_log}"
    # The authorization component, on the same scratch database. Its store
    # contract runs against the in-memory double and against PostgreSQL, and
    # the SQL half is the half that matters: the grant is enforced in the
    # statements, so a run without a database reports the double's behaviour
    # as the system's. This suite ran in no target at all until now.
    mcp_auth_log="$(mktemp)"
    if ! "${compose[@]}" run --rm --build --no-deps \
      --volume "${ROOT_DIR}:/workspace:ro" \
      --env PYTHONPATH=/app \
      --env PYTHONDONTWRITEBYTECODE=1 \
      --env "CONTROL_TEST_DATABASE_URL=${control_test_url}" \
      --entrypoint python \
      mcp-auth \
      -m unittest discover -s /workspace/mcp-auth/tests -v 2>&1 \
      | tee "${mcp_auth_log}"; then
      rm -f "${mcp_auth_log}"
      exit 1
    fi
    if grep -q "skipped=" "${mcp_auth_log}"; then
      rm -f "${mcp_auth_log}"
      printf 'Authorization tests skipped; the store contract must run against PostgreSQL.\n' >&2
      exit 1
    fi
    rm -f "${mcp_auth_log}"
    # The MCP runtime. No database and no network: the era guard, the metadata
    # surface and the authentication middleware are driven directly over the
    # ASGI contract, because that is where their obligations live -- "never
    # emits Mcp-Session-Id" is a claim about a response message, not about a
    # rendered page. The skip guard applies for the same reason as the others:
    # a suite that quietly stops running is worse than one that fails.
    mapp_mcp_log="$(mktemp)"
    if ! "${compose[@]}" run --rm --build --no-deps \
      --volume "${ROOT_DIR}:/workspace:ro" \
      --env PYTHONPATH=/app:/workspace/mapp-mcp/tests \
      --env PYTHONDONTWRITEBYTECODE=1 \
      --entrypoint python \
      mapp-mcp \
      -m unittest discover -s /workspace/mapp-mcp/tests -v 2>&1 \
      | tee "${mapp_mcp_log}"; then
      rm -f "${mapp_mcp_log}"
      exit 1
    fi
    if grep -q "skipped=" "${mapp_mcp_log}"; then
      rm -f "${mapp_mcp_log}"
      printf 'MCP runtime tests skipped; none of them may be conditional.\n' >&2
      exit 1
    fi
    rm -f "${mapp_mcp_log}"
    # The semantic-service suite exercises real SQL against a real server: a
    # mocked cursor cannot fail the way PostgreSQL fails when it parses a
    # statement, which is the whole reason those tests exist. Without
    # SEMANTIC_TEST_DATABASE_URL every one of them skips and the run still
    # reports OK, so the database is stood up here rather than left to
    # whoever remembers. It is a scratch database and never the packaged
    # catalogue -- the fixture drops and recreates the schema it is pointed
    # at. The database is already up from the configuration suite above.
    "${compose[@]}" exec -T db sh -c \
      'exec psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" \
        --set ON_ERROR_STOP=1 \
        --command "DROP DATABASE IF EXISTS mapp_semantic_test" \
        --command "CREATE DATABASE mapp_semantic_test"' >/dev/null
    "${compose[@]}" run --rm --build --no-deps \
      --volume "${ROOT_DIR}/semantic-service:/workspace:ro" \
      --workdir /workspace \
      --env PYTHONDONTWRITEBYTECODE=1 \
      --env "SEMANTIC_TEST_DATABASE_URL=postgresql://$(dotenv_value POSTGRES_USER):$(dotenv_value POSTGRES_PASSWORD)@db:5432/mapp_semantic_test?sslmode=disable" \
      semantic-service \
      python -m unittest discover -s tests -v
    docker run --rm \
      --volume "${ROOT_DIR}:/workspace:ro" \
      --env PYTHONPATH=/app/src \
      mapp-leeds-etl:local \
      python -m unittest discover -s /workspace/etl/tests -v
    PYTHONPATH="${ROOT_DIR}" \
      python3 -m unittest discover -s "${ROOT_DIR}/scripts/tests" -v
    docker run --rm \
      --volume "${ROOT_DIR}:/source:ro" \
      --workdir /tmp \
      "${NODE_IMAGE:-node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3}" \
      sh -c '
        cp -a /source/config-ui /tmp/config-ui
        mkdir -p /tmp/instance/public
        cp -a /source/instance/public/plugins /tmp/instance/public/plugins
        cd /tmp/config-ui
        npm ci
        npm test
        npm run build
        npm audit --omit=dev
        node --check /source/docker/xyz/supervisor.mjs
        node --check /source/browser-runner/server.mjs
      '
    run_with_buildkit_lease_retry "${compose[@]}" build egress-proxy
    PYTHONDONTWRITEBYTECODE=1 python3 "${ROOT_DIR}/scripts/test_egress_proxy.py"
    "${compose[@]}" config --quiet
    docker compose \
      --project-directory "${ROOT_DIR}" \
      --env-file "${ROOT_DIR}/.env.example" \
      --file "${ROOT_DIR}/compose.yaml" \
      config --quiet
    docker compose \
      --project-directory "${ROOT_DIR}" \
      --env-file "${ROOT_DIR}/.env.example" \
      --file "${ROOT_DIR}/compose.yaml" \
      --file "${ROOT_DIR}/compose.bundled-db.yaml" \
      config --quiet
    # The opt-in overlays resolve only when the template carries their own
    # keys. Shipping an overlay nobody can resolve from .env.example is how
    # the two-source demo arrived broken, so both are validated here.
    docker compose \
      --project-directory "${ROOT_DIR}" \
      --env-file "${ROOT_DIR}/.env.example" \
      --file "${ROOT_DIR}/compose.yaml" \
      --file "${ROOT_DIR}/compose.bundled-db.yaml" \
      --file "${ROOT_DIR}/compose.federation-test.yaml" \
      --file "${ROOT_DIR}/compose.federated-demo.yaml" \
      config --quiet
    printf 'Unit tests, semantic-service tests, and Compose validation for the base, packaged-database, and opt-in overlay models passed.\n'
    ;;
  config)
    "${compose[@]}" config --quiet
    printf 'Compose configuration is valid.\n'
    ;;
  build-xyz)
    run_with_buildkit_lease_retry "${compose[@]}" build --pull xyz
    ;;
  ps)
    "${compose[@]}" ps
    ;;
  logs)
    "${compose[@]}" logs --follow --tail 200
    ;;
  db)
    postgres_user="$(environment_value POSTGRES_USER)"
    postgres_db="$(environment_value POSTGRES_DB)"
    "${compose[@]}" exec db psql --username "${postgres_user}" --dbname "${postgres_db}"
    ;;
  reset-config-password)
    # These are the commands you reach for when locked out, and the credential
    # now lives in the database, so the database has to be running. --no-deps
    # alone used to be enough when it was a file; on its own it would now fail
    # with no database at all.
    "${compose[@]}" up --detach --wait db >/dev/null
    "${compose[@]}" run --rm --build --no-deps config-ui \
      python config_admin.py reset-password --root /control
    ;;
  revoke-config-tokens)
    "${compose[@]}" up --detach --wait db >/dev/null
    "${compose[@]}" run --rm --build --no-deps config-ui \
      python config_admin.py revoke-tokens --root /control
    ;;
  advance-recovery-epoch)
    # Run after restoring a database and before serving traffic: a snapshot
    # carries every credential that was valid when it was taken, including ones
    # revoked since. config_admin prints the plan and refuses without
    # --confirm; arguments are forwarded verbatim and --confirm is never
    # injected.
    #
    # --no-deps deliberately: this needs the database and must not start the
    # application, because the whole point is to invalidate the credentials
    # before anything can accept one.
    "${compose[@]}" up --detach --wait db >/dev/null
    "${compose[@]}" run --rm --build --no-deps config-ui \
      python config_admin.py advance-recovery-epoch --root /control "${@:2}"
    ;;
  migrate-rollback)
    # Destructive, and the plan is printed by config_admin rather than here:
    # it reads the migration ledger, so the warning names the versions this
    # database actually has instead of a paragraph that goes stale the first
    # time a migration is added. Arguments are forwarded verbatim -- --confirm
    # is never injected, so the unconfirmed path is the default.
    "${compose[@]}" up --detach --wait db >/dev/null
    "${compose[@]}" run --rm --build --no-deps config-ui \
      python config_admin.py migrate-rollback --root /control "${@:2}"
    ;;
  mcp-client-register|mcp-client-list|mcp-client-disable|mcp-runtime-register)
    # The agent-client registry. Nothing else registers a client, so without
    # this the authorization component starts with an empty client table and
    # refuses every authorization request as an unknown client.
    #
    # An agent is a *public* client: it authenticates with PKCE and no secret,
    # so there is nothing to print once and nothing to store on the operator's
    # machine. Arguments are forwarded so --redirect-uri and --scope can repeat.
    "${compose[@]}" up --detach --wait db >/dev/null
    "${compose[@]}" run --rm --build --no-deps config-ui \
      python config_admin.py "$1" --root /control "${@:2}"
    ;;
  stop)
    "${compose[@]}" stop
    ;;
  down)
    "${compose[@]}" down
    ;;
  *)
    usage
    exit 2
    ;;
esac
