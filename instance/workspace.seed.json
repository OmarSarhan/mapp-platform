{
  "key": "leeds-mapp-explore",
  "dbs": "MAPP",
  "locale": {
    "name": "Leeds GIS sampler",
    "extent": {
      "north": 54,
      "east": -1.2,
      "south": 53.65,
      "west": -1.85,
      "mask": true
    },
    "view": {
      "lat": 53.8008,
      "lng": -1.5491,
      "z": 11
    },
    "mapviewControls": [
      "Zoom"
    ],
    "ScaleLine": "metric",
    "layers": {
      "OpenStreetMap": {
        "display": true,
        "format": "tiles",
        "URI": "https://{a-c}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        "attribution": {
          "© OpenStreetMap contributors": "https://www.openstreetmap.org/copyright"
        }
      },
      "Bus Stops": {
        "name": "Leeds Bus Stops",
        "display": true,
        "format": "mvt",
        "dbs": "MAPP",
        "table": "leeds.bus_stops",
        "geom": "geom_3857",
        "srid": "3857",
        "qID": "object_id",
        "attribution": {
          "Leeds City Council source": "https://mapservices.leeds.gov.uk/arcgis/rest/services/Public/Transportation/MapServer/0",
          "Leeds data terms": "https://www.leeds.gov.uk/opendata/terms-and-licences"
        },
        "infoj": [
          {
            "type": "geometry",
            "display": true,
            "field": "geom_3857",
            "fieldfx": "ST_AsGeoJSON(geom_3857)"
          },
          {
            "type": "pin",
            "label": "Location",
            "field": "pin",
            "fieldfx": "ARRAY[ST_X(ST_PointOnSurface(geom_3857)), ST_Y(ST_PointOnSurface(geom_3857))]"
          },
          {
            "title": "Object ID",
            "field": "object_id",
            "inline": true
          },
          {
            "title": "Stop",
            "field": "stop_name",
            "inline": true
          },
          {
            "title": "Stop ID",
            "field": "stop_id",
            "inline": true
          },
          {
            "title": "Town",
            "field": "town",
            "inline": true
          },
          {
            "title": "On street",
            "field": "on_street",
            "inline": true
          },
          {
            "title": "Towards",
            "field": "towards",
            "inline": true
          },
          {
            "title": "Updated",
            "field": "updated_at",
            "inline": true
          }
        ],
        "style": {
          "default": {
            "icon": {
              "url": "/instance/svg/bus.svg",
              "scale": 1
            }
          },
          "highlight": {
            "highlightScale": 1.4,
            "icon": {
              "url": "/instance/svg/target-marker.svg",
              "scale": 1
            }
          },
          "hover": {
            "display": true,
            "field": "stop_name",
            "title": "Bus stop"
          }
        }
      },
      "Definitive Paths": {
        "name": "Definitive Public Rights of Way",
        "display": true,
