# Copy with `./bin/mapp init`. Values are read by Docker Compose but are never
# mounted into the XYZ container as files.
COMPOSE_PROJECT_NAME=mapp-explore

# Images, public sites, and the only host bindings.
POSTGIS_IMAGE=postgis/postgis:17-3.5
CADDY_IMAGE=caddy:2.10.0-alpine
NODE_IMAGE=node:22.23.1-bookworm-slim
EDGE_BIND_ADDRESS=127.0.0.1
HTTP_PORT=3000
HTTPS_PORT=3443
BROWSER_MAX_CONCURRENT_RUNS=1
MAP_SITE=http://localhost
CONFIG_SITE=http://config.localhost
CONFIG_ALLOWED_HOSTS=localhost,127.0.0.1,config.localhost,config-ui
# Local HTTP only. compose.production.yaml overrides this to true.
CONFIG_SECURE_COOKIES=false
CADDY_EMAIL=
# Production uses separate, intentionally blank settings so the hardening
# overlay cannot silently inherit the local HTTP defaults.
PRODUCTION_MAP_SITE=
PRODUCTION_CONFIG_SITE=
PRODUCTION_CONFIG_ALLOWED_HOSTS=
PRODUCTION_CADDY_EMAIL=
# Host owner of var/workspace and var/control; permits atomic saves without root.
CONFIG_UID=1000
CONFIG_GID=1000

# The framework is pinned twice: a readable release and its immutable commit.
XYZ_REF=v4.23.4
XYZ_COMMIT=a6f03c07dd7aaae2e9ab04087143ee0400e15cb9
XYZ_IMAGE_TAG=v4.23.4-a6f03c0

# Database bootstrap. Keep passwords URL-safe because they are interpolated
# into PostgreSQL connection URIs for XYZ and the ETL job.
POSTGRES_DB=mapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME_POSTGRES
ETL_DB_USER=mapp_etl
ETL_DB_PASSWORD=CHANGEME_ETL
XYZ_DB_USER=mapp_xyz
XYZ_DB_PASSWORD=CHANGEME_XYZ

# Only used with compose.db-port.yaml; the normal stack does not publish DB.
DB_BIND_ADDRESS=127.0.0.1
DB_PORT=5432
