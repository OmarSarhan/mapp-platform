# Copy with `./bin/mapp init`. Values are read by Docker Compose but are never
# mounted into the XYZ container as files.
COMPOSE_PROJECT_NAME=mapp-explore
# Persist the topology choice. Development is loopback HTTP only; production
# enables the Caddy HTTPS hardening overlay and validates public settings.
MAPP_ENVIRONMENT=development

# Images, development sites, and the only host bindings. Production requires a
# non-loopback EDGE_BIND_ADDRESS plus HTTP_PORT=80 and HTTPS_PORT=443.
POSTGIS_IMAGE=mapp-postgis-h3:17-3.5-4.2.3
H3_PG_REF=v4.2.3
H3_PG_COMMIT=a26630b8353d441e6bc8065c0a8dcaa3d89ef87b
NODE_IMAGE=node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
EDGE_BIND_ADDRESS=127.0.0.1
HTTP_PORT=3000
HTTPS_PORT=3443
BROWSER_MAX_CONCURRENT_RUNS=1
# One browser run is bounded independently; proposal screenshots may run both
# original and candidate inside the larger durable-operation deadline.
VISUAL_RUN_TIMEOUT_MS=90000
VISUAL_BROWSER_TIMEOUT_SECONDS=90
VISUAL_BACKGROUND_TIMEOUT_SECONDS=300
MAP_SITE=http://localhost
CONFIG_SITE=http://config.localhost
CONFIG_ALLOWED_HOSTS=localhost,127.0.0.1,config.localhost,config-ui
# Local HTTP only. compose.production.yaml overrides this to true.
CONFIG_SECURE_COOKIES=false
# Shared only by config-ui and the private semantic service. `./bin/mapp init`
# replaces this placeholder; existing instances can use `doctor --add-missing`.
SEMANTIC_INTERNAL_TOKEN=CHANGEME_SEMANTIC
# Metadata-only semantic source discovery/sync. Entries are comma-separated,
# exact database aliases plus schema/relation patterns; `*` is relation-only.
SEMANTIC_SOURCE_ALLOWLIST=MAPP:source_leeds_ext.*,MAPP:source_census.*,MAPP:source_ops.*
SEMANTIC_SOURCE_EXCLUSIONS=
CADDY_EMAIL=
# Production uses separate, intentionally blank settings so the hardening
# overlay cannot silently inherit the local HTTP defaults.
PRODUCTION_MAP_SITE=
PRODUCTION_CONFIG_SITE=
PRODUCTION_CONFIG_ALLOWED_HOSTS=
PRODUCTION_CADDY_EMAIL=
# Host owner of var/workspace and var/control; permits atomic saves without root.
CONFIG_UID=1000
CONFIG_GID=1000

# The framework is pinned twice: a readable release and its immutable commit.
XYZ_REF=v4.23.4
XYZ_COMMIT=a6f03c07dd7aaae2e9ab04087143ee0400e15cb9
XYZ_IMAGE_TAG=v4.23.4-a6f03c0

# Database identities. The administrator and ETL role are used only by the
# bundled sample database. The XYZ role is the bundled read-only identity and
# is referenced by the default DBS_MAPP connection below.
POSTGRES_DB=mapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME_POSTGRES
ETL_DB_USER=mapp_etl
ETL_DB_PASSWORD=CHANGEME_ETL
XYZ_DB_USER=mapp_xyz
XYZ_DB_PASSWORD=CHANGEME_XYZ
DERIVED_DB_USER=mapp_derived
DERIVED_DB_PASSWORD=CHANGEME_DERIVED
DERIVED_OWNER_ROLE=mapp_derived
DERIVED_READER_ROLE=mapp_xyz
FEDERATION_DB_USER=mapp_federation
FEDERATION_DB_PASSWORD=CHANGEME_FEDERATION
# The semantic catalog is held in the packaged database, in its own schema,
# behind two login roles. The first owns schema `semantic` and is the only
# identity allowed to write it; the second may only SELECT from it and is used
# for every catalog read. CLI and API semantic scopes remain the primary
# gate; these roles are the structural backstop behind them.
SEMANTIC_DB_USER=mapp_semantic
SEMANTIC_DB_PASSWORD=CHANGEME_SEMANTIC_CRUD
SEMANTIC_READER_DB_USER=mapp_semantic_reader
SEMANTIC_READER_DB_PASSWORD=CHANGEME_SEMANTIC_READER

# Runtime database routing. XYZ and the configuration dashboard receive the
# exact same DBS_MAPP value, which points at the packaged PostGIS database.
# Percent-encode URI-reserved characters in usernames and passwords.
# For publicly trusted external TLS, use sslmode=verify-full and the shared
# sslrootcert=/etc/ssl/certs/ca-certificates.crt path documented in README.md.
DBS_MAPP=postgresql://${XYZ_DB_USER}:${XYZ_DB_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=disable

# Optional sample ETL destination. This is deliberately independent from
# DBS_MAPP and is used only by `./bin/mapp etl`.
ETL_DATABASE_URL=postgresql://${ETL_DB_USER}:${ETL_DB_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=disable

# Used only by the configuration service to manage audited views and
# materialized views in the derived_layers schema.
DERIVED_DATABASE_URL=postgresql://${DERIVED_DB_USER}:${DERIVED_DB_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=disable
# Separate role that owns the federation registry, FDW servers, and
# source_<alias> schemas; it must not be reused as the derived owner.
# Required by every deployment, even with no aliases registered: the packaged
# database is the federation host.
FEDERATION_DATABASE_URL=postgresql://${FEDERATION_DB_USER}:${FEDERATION_DB_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=disable
# Used only by the private semantic service: the first DSN writes the semantic
# schema, the second only reads it. Both are required by every deployment,
# because the catalog is created on first start.
SEMANTIC_DATABASE_URL=postgresql://${SEMANTIC_DB_USER}:${SEMANTIC_DB_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=disable
SEMANTIC_READER_DATABASE_URL=postgresql://${SEMANTIC_READER_DB_USER}:${SEMANTIC_READER_DB_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=disable
# Admission limit for create, replace, and refresh background workers. The
# database mutation lock serializes bundled derived DDL, so one is recommended.
DERIVED_MAX_BACKGROUND_JOBS=1
# Optional, config-ui-only credential for reviewable semantic drafts.
# Metadata is sent by default; semantic:data callers may explicitly add capped
# sample rows or statistics. The key never reaches the browser, CLI, semantic
# service, or XYZ.
GEMINI_APIKEY=
GEMINI_MODEL=gemini-3.6-flash
# Only used with compose.db-port.yaml; the normal stack does not publish the
# bundled sample database.
DB_BIND_ADDRESS=127.0.0.1
DB_PORT=5432

# Opt-in federation FDW test rig (compose.federation-test.yaml). Not started
# by default; see docker/source-db/seed.sh. SOURCE_POSTGRES_* are the
# standalone "source-db" container's own admin credentials; SOURCE_READER_*
# is the restricted role its FDW user mapping actually connects as.
# FEDERATION_DBS_* is used by federation Observe/Provision and the verifier;
# the configuration service excludes it from ordinary catalog, layer, and
# semantic discovery.
SOURCE_POSTGRES_DB=leeds_ext
SOURCE_POSTGRES_USER=postgres
SOURCE_POSTGRES_PASSWORD=CHANGEME_SOURCE_POSTGRES
SOURCE_READER_USER=mapp_source_reader
SOURCE_READER_PASSWORD=CHANGEME_SOURCE_READER
FEDERATION_DBS_LEEDS_EXT=postgresql://${SOURCE_READER_USER}:${SOURCE_READER_PASSWORD}@source-db:5432/${SOURCE_POSTGRES_DB}?sslmode=require&gssencmode=disable

# Opt-in two-source federated demo (compose.federated-demo.yaml). Not started
# by default; see docker/demo-sources/seed.sh. Census data and the operational
# layers live in separate databases, both reached over postgres_fdw, so the
# host database holds only derived output, the federation registry and the
# source_<alias> foreign tables. Both reuse SOURCE_POSTGRES_USER and the
# SOURCE_READER_* role above; only the database names and their own admin
# passwords differ.
CENSUS_POSTGRES_DB=census
CENSUS_POSTGRES_PASSWORD=CHANGEME_CENSUS_POSTGRES
OPS_POSTGRES_DB=ops
OPS_POSTGRES_PASSWORD=CHANGEME_OPS_POSTGRES
FEDERATION_DBS_CENSUS=postgresql://${SOURCE_READER_USER}:${SOURCE_READER_PASSWORD}@census-db:5432/${CENSUS_POSTGRES_DB}?sslmode=require&gssencmode=disable
FEDERATION_DBS_OPS=postgresql://${SOURCE_READER_USER}:${SOURCE_READER_PASSWORD}@ops-db:5432/${OPS_POSTGRES_DB}?sslmode=require&gssencmode=disable

# Set to a non-empty value to run the two-source Leeds demo: `./bin/mapp init
# --demo` sets it, and every wrapper command then applies
# compose.federated-demo.yaml and starts census-db and ops-db alongside the
# platform. Leave empty for a plain install. Populate the demo itself with
# `./bin/mapp demo`, which seeds both source databases and publishes the map
# layers built from them.
MAPP_DEMO_SOURCES=

# How many fields per relation `./bin/mapp demo` describes with Gemini. This
# value in .env is authoritative. Each field is one model call, and
# census_2021_england_oa alone has 470 columns, so fresh environments default
# to 50. Raise it for a fuller catalogue, or leave it empty to describe every
# field. A relation with more fields than this has its table described and its
# fields left to the structural profile.
MAPP_DEMO_FIELD_LIMIT=50
